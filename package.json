{
  "name": "threejs-3d-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "ts:check": "tsc --noEmit",
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:chromium": "playwright test --project=chromium",
    "test:cross-browser": "playwright test --project=chromium --project=edge --project=firefox --project=webkit",
    "test:mobile": "playwright test --project=\"ios-*\" --project=\"android-*\" --project=\"tablet-*\"",
    "test:a11y": "playwright test --grep @a11y",
    "test:api": "playwright test --project=api",
    "test:visual": "playwright test --project=chromium --grep @visual",
    "test:visual:update": "playwright test --project=chromium --grep @visual --update-snapshots",
    "test:prod": "playwright test --project=chromium --grep @smoke",
    "test:report": "playwright show-report",
    "test:typecheck": "tsc -p tests/tsconfig.json",
    "test:responsive": "playwright test --grep @responsive"
  },
  "dependencies": {
    "@emailjs/browser": "^3.10.0",
    "@react-three/drei": "^9.99.0",
    "@react-three/fiber": "^8.11.1",
    "@splinetool/react-spline": "^4.2.0",
    "@splinetool/runtime": "^2.0.151",
    "@vercel/analytics": "^1.2.2",
    "@vercel/speed-insights": "^1.0.10",
    "animate.css": "^4.1.1",
    "canvas-confetti": "^1.9.2",
    "framer-motion": "^9.0.7",
    "lucide-react": "^1.70.0",
    "maath": "^0.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga": "^3.3.1",
    "react-parallax-tilt": "^1.7.180",
    "react-router-dom": "^6.8.1",
    "react-scripts": "^5.0.1",
    "react-text-transition": "^3.1.0",
    "react-vertical-timeline-component": "^3.6.0",
    "three": "^0.161.0",
    "three-mesh-bvh": "^0.7.3",
    "wowjs": "^1.1.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/canvas-confetti": "^1.6.4",
    "@types/node": "^26.6.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-vertical-timeline-component": "^3.3.6",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.13",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.21",
    "prettier": "^3.1.1",
    "tailwindcss": "^3.2.6",
    "typescript": "^5.9.3",
    "vite": "^5.0.8"
  },
  "description": "",
  "main": "vite.config.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moussasg/My3DPortfolio.git"
